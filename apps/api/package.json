{
  "name": "@meal/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "check:connection": "tsx --env-file-if-exists=.env scripts/check-connection.ts",
    "check:kitchen": "tsx --env-file-if-exists=.env scripts/check-kitchen.ts",
    "check:checkout": "tsx --env-file-if-exists=.env scripts/check-checkout.ts",
    "check:grocery-details": "tsx --env-file-if-exists=.env scripts/check-grocery-details.ts",
    "check:milestone-one": "tsx --env-file-if-exists=.env scripts/check-milestone-one.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "spec:write": "tsx scripts/generate-openapi.ts --write",
    "spec:check": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "@meal/contracts": "0.1.0",
    "@supabase/supabase-js": "^2.57.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12"
  }
}
