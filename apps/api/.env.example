SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-project-publishable-key
PORT=3000
HOST=0.0.0.0
APP_ENV=development

# Browser origin allowed by CORS (no trailing slash)
WEB_ORIGIN=http://localhost:8081
LOG_LEVEL=info
FEATURE_CATALOG=true
FEATURE_SAVED_RECIPES=true

# Server only. Never use an EXPO_PUBLIC_ variable for this privileged key.
# Enable only after applying the account-deletion migration in this environment.
# SUPABASE_SECRET_KEY=replace-with-server-secret-or-service-role-key

# Server only; the root .env.local is also loaded by the API.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4.1-mini
