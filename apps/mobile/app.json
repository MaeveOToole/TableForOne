{
  "expo": {
    "name": "Table for One",
    "slug": "meal-planner",
    "scheme": "mealplanner",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mealplanner.app",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": ["expo-secure-store", "expo-status-bar", "expo-sqlite"],
    "platforms": ["ios", "web"],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "environment": "development",
      "releaseScope": "core",
      "eas": {
        "projectId": "137583ff-377c-4c8a-8094-457257421a38"
      }
    },
    "owner": "donarduous-1"
  }
}
