{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_ENV": "development", "EXPO_PUBLIC_RELEASE_SCOPE": "core" }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_ENV": "staging", "EXPO_PUBLIC_RELEASE_SCOPE": "core" }
    },
    "preview": { "extends": "staging" },
    "production": {
      "credentialsSource": "remote",
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": { "APP_ENV": "production", "EXPO_PUBLIC_RELEASE_SCOPE": "core" }
    }
  },
  "submit": {
    "production": {
      "ios": { "appleTeamId": "QKQ2WNHKWS" }
    }
  }
}
